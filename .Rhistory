labs(title = "Post-Treatment Income on Treated Households",
x = "Income",
y = "Number of Households") +
theme_minimal()
# define an object that holds earnings for untreated households
untreated_inc <- df_data$endline_income[df_data$farms_trt == 0]
# compute the median untreated income
med_untreat_inc <- median(untreated_inc, na.rm = TRUE)
# plot income of untreated households
ggplot(data.frame(treated_inc), aes(x = treated_inc)) +
geom_histogram(fill = "skyblue", color = "white", bins = 10) +
geom_vline(xintercept = med_untreat_inc, color = "red") +
annotate("text",
x = med_untreat_inc,
y = Inf,
label = paste("Median =", round(med_untreat_inc, 2)),
vjust = 2,
color = "red") +
labs(title = "Post-Treatment Income on Unreated Households",
x = "Income",
y = "Number of Households") +
theme_minimal()
# BALANCE TEST
# run regression on each covariate (week 2 TA session)
regressions <- df_data %>%
select("baseline_income",
"baseline_agexp",
"baseline_hhsize",
"baseline_livestock") %>%
lapply(function(x) lm(x ~ farms_trt, data = df_data))
# pull the regression coefficient and p-value
balance_table <- regressions %>%
sapply(function(x) coef(summary(x))[c(2,8)]) %>%
t()
# format the table output
balance_table %>%
kable(col.names = c("Differences in means", "p-value")) %>%
kable_styling(position = "center", font_size = 8.5, latex_options = "hold_position")
# regress income on endline amount of agricultural investment
reg_end_agexp <- lm(endline_income ~ farms_trt + endline_agexp,
data = df_data)
summary(reg_end_agexp)
# estimate the ATE
base_rg <- lm(endline_income ~ farms_trt,
data = df_data)
summary(base_rg)
# regress income on treatment and endline amount of agricultural investment
reg_end_agexp <- lm(endline_income ~ farms_trt + endline_agexp,
data = df_data)
summary(reg_end_agexp)
# regress income on treatment and baseline ag investment
reg_bl_agexp <- lm(endline_income ~ farms_trt + endline_agexp,
data = df_data)
summary(reg_bl_agexp)
# regress income on treatment and endline amount of agricultural investment
reg_end_agexp <- lm(endline_income ~ farms_trt + endline_agexp,
data = df_data)
summary(reg_end_agexp)
# regress income on treatment and baseline ag investment
reg_bl_agexp <- lm(endline_income ~ farms_trt + baseline_agexp,
data = df_data)
summary(reg_bl_agexp)
# source: https://www.statology.org/subset-data-frame-in-r/
df_treated <- subset(df_data, farms_trt = 1)
#df_data$baseline_income[df_data$farms_trt == 1]
# source: https://www.statology.org/subset-data-frame-in-r/
df_treated <- subset(df_data, farms_trt == 1)
#df_data$baseline_income[df_data$farms_trt == 1]
# source: https://www.statology.org/subset-data-frame-in-r/
# make a new df with only those assigned treatment
df_treated <- subset(df_data, farms_trt == 1)
# run a regression on microcredit usage
itt_reg <- lm(endline_income ~ farms_got_loan,
data = df_treated)
summary(itt_reg)
# estimate the ATE
base_rg <- lm(endline_income ~ farms_trt,
data = df_data)
summary(base_rg)
